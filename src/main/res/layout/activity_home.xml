<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".home.HomeActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:background="#F5F5F5">

        <LinearLayout
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_home"
            android:id="@+id/layoutHome"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/tvLogo"
            app:layout_constraintTop_toTopOf="parent"
            android:text="STOPP!NG"
            android:textSize="24sp"
            android:layout_marginTop="30dp"
            android:layout_marginStart="35dp"
            app:layout_constraintStart_toStartOf="parent"/>

        <FrameLayout
            android:id="@+id/layoutMainBtn"
            android:clickable="true"
            android:focusable="true"
            android:layout_width="340dp"
            android:layout_height="212dp"
            android:elevation="5dp"
            android:background="@drawable/rounded_white_btn"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvLogo">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_main_btn"
                android:layout_gravity="end"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="바로가기"
                android:textColor="#333333"
                android:fontFamily="@font/bmjua_otf"
                android:textSize="15sp"
                android:layout_marginTop="100dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:layout_marginStart="30dp"
                android:background="@drawable/rounded_pink_btn"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="도움이 필요하신가요?\nAI로 분석하는 스토킹 행위 진단"
                android:fontFamily="@font/bmjua_otf"
                android:textSize="20sp"
                android:layout_marginTop="135dp"
                android:layout_marginStart="30dp"
                android:textColor="@color/black"/>

        </FrameLayout>

        <LinearLayout
            android:id="@+id/layoutCategory"
            android:layout_width="340dp"
            android:layout_height="95dp"
            android:gravity="center"
            android:background="@drawable/rounded_white_btn"
            app:layout_constraintTop_toBottomOf="@+id/layoutMainBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:orientation="horizontal"
            android:elevation="5dp"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:id="@+id/layoutInfo"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_info"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#333333"
                    android:text="맞춤형"/>

                <TextView
                    android:textColor="#333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="지원 제도"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutTest"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:textColor="#333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:src="@drawable/icon_test"/>

                <TextView
                    android:textColor="#333333"
                    android:layout_marginTop="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="AI 진단"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutSol"
                android:layout_width="0dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_sol"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:text="유형별"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:text="대응 방안"/>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutCheck"
            android:layout_width="340dp"
            android:layout_height="120dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutCategory"
            android:background="@drawable/rounded_white_btn"
            android:elevation="5dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:layout_marginStart="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="맞춤형\n지원 제도\n확인"
                android:textSize="16sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:textColor="@color/black"
                android:layout_gravity="center"
                android:layout_weight="1"/>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/icon_info2"
                android:layout_weight="1"
                android:layout_marginEnd="20dp"
                android:layout_gravity="center"/>

            <TextView
                android:layout_marginStart="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="유형별\n대응 방안\n안내"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:clickable="true"
                android:focusable="true"
                android:layout_gravity="center"
                android:layout_weight="1"/>

            <ImageView
                android:layout_width="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_sol2"
                android:layout_weight="1"
                android:layout_marginEnd="20dp"
                android:layout_gravity="center"/>

        </LinearLayout>

        <FrameLayout
            android:clickable="true"
            android:focusable="true"
            android:id="@+id/layoutChat"
            android:layout_width="340dp"
            android:layout_height="90dp"
            app:layout_constraintTop_toBottomOf="@+id/layoutCheck"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:elevation="5dp"
            android:layout_marginTop="20dp"
            android:clipChildren="false"
            android:background="@drawable/rounded_pink_btn"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivDoctor"
                android:layout_width="wrap_content"
                android:layout_height="120dp"
                android:src="@drawable/icon_doctor"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:text="📞 상담이 필요하신가요?"
                android:textSize="17sp"
                android:layout_marginTop="17dp"
                android:layout_marginStart="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:text="전화상담 &amp; 실시간 채팅 상담 연결"
                android:textSize="15sp"
                android:layout_marginTop="17dp"
                android:layout_marginStart="30dp"
                android:layout_gravity="center_vertical" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="340dp"
            android:layout_height="115dp"
            android:id="@+id/layoutNews"
            app:layout_constraintTop_toBottomOf="@+id/layoutChat"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="@drawable/rounded_border_white_btn"
            android:elevation="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="40dp"
            android:orientation="vertical"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 투데이"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="17dp"
                android:layout_marginStart="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="#5D5D5D"
                android:text="~~~기사 제목~~~\ndfdfdfddfdfdfdfdfdf"
                android:textSize="17sp"
                android:layout_marginTop="3dp"
                android:clickable="true"
                android:maxLines="2"
                android:ellipsize="end"
                android:focusable="true"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>